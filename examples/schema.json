{
  "vars": {
    "APP_NAME": { "required": true, "description": "Display name of the service" },
    "NODE_ENV": { "required": true, "description": "development, production or test" },
    "PORT": { "type": "port", "description": "HTTP port" },
    "DATABASE_URL": { "type": "url", "protocols": ["postgres", "postgresql"], "required": true, "description": "Primary database" },
    "API_KEY": { "required": true, "description": "Key for the payments API" },
    "DEBUG": { "type": "boolean", "description": "Verbose logging" },
    "ADMIN_EMAIL": { "type": "email", "description": "Where alerts go" }
  }
}
